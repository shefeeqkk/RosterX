<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_roster"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_roster"
        android:shortcutShortLabel="@string/shortcut_roster_short"
        android:shortcutLongLabel="@string/shortcut_roster_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://api.rosterx.online/open/roster"
            android:targetPackage="com.rosterx"
            android:targetClass="com.rosterx.MainActivity" />
    </shortcut>

    <shortcut
