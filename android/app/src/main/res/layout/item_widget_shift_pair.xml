<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_pair_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="1.5dp"
    android:paddingBottom="1.5dp">

    <!-- Column 1 (Left Engineer) -->
    <LinearLayout
        android:id="@+id/pair_left_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_inner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/left_badge_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shift_squircle" />

            <TextView
                android:id="@+id/left_badge_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="FS"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/left_engineer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Nandu"
                    android:textColor="@color/widget_text_main"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/left_active_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:src="@drawable/widget_dot_active"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/left_shift_timing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:singleLine="true"
                android:text="07:30 - 04:30"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column Gap -->
    <Space
        android:layout_width="4dp"
        android:layout_height="match_parent" />

    <!-- Column 2 (Right Engineer) -->
    <LinearLayout
        android:id="@+id/pair_right_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_inner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/right_badge_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shift_squircle" />

            <TextView
                android:id="@+id/right_badge_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="FS"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/right_engineer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Dhanush"
                    android:textColor="@color/widget_text_main"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/right_active_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:src="@drawable/widget_dot_active"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/right_shift_timing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:singleLine="true"
                android:text="07:30 - 04:30"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
