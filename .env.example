# RosterX Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.

# MongoDB Atlas Connection URI (e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=your_mongodb_atlas_uri_here

# MongoDB Atlas Cluster & Database Configuration
ATLAS_CLUSTER=Cluster0
ATLAS_DATABASE=rosterx_db

# Google Gemini API Key for Smart Shift Generation & Conversational AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Resend API Key for Email OTP Dispatch (Password Reset)
RESEND_API_KEY=re_your_resend_api_key_here
