# RosterX Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.

# MongoDB Atlas Connection URI (e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=your_mongodb_atlas_uri_here

# MongoDB Atlas Cluster & Database Configuration
ATLAS_CLUSTER=Cluster0
ATLAS_DATABASE=rosterx

# Google Gemini API Key for Smart Shift Generation & Conversational AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Resend API Key for Email OTP Dispatch (Password Reset)
RESEND_API_KEY=re_your_resend_api_key_here
ALERT_EMAIL=admin@rosterx.dev

# Gmail SMTP Credentials for Native OTP Email (Password Recovery)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Security & Authentication Configuration
# Set a strong 64-char hex key or random string for JWT signature verification
AUTH_SECRET_KEY=your_random_64_character_hex_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# Android Verified App Links & Deep-Link CTAs
# Comma-separated SHA-256 signing certificate fingerprints (e.g. from keytool -list -v)
ANDROID_APP_LINK_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
APP_PUBLIC_BASE_URL=https://api.rosterx.online

# Android In-App Update Metadata (served by GET /api/server-info)
MIN_SUPPORTED_VERSION=1.30.0
APK_DOWNLOAD_URL=https://github.com/<your-org-or-user>/RosterX/releases/latest
